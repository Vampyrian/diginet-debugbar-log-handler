{
    "name": "vampyrian/monolog-debugbar",
    "version": "0.1.2-alpha",
    "license": "MIT",
    "php": "^8.3",
    "autoload": {
        "psr-4": {
            "Vampyrian\\DiginetDebugbar\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Žilvinas Mačius",
            "email": "zivinas.macius@gmail.lt"
        }
    ],
    "require": {
        "monolog/monolog": "^3.12"
    },
    "require-dev": {
